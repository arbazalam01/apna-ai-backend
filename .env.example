# Copy to .env and fill in: cp .env.example .env
# `npm start` loads .env automatically (node --env-file-if-exists).

PORT=3000
MONGO_DB=mongodb://localhost:27017/apna-ai
SECRET=any-long-random-string            # JWT secret
CLIENT_URL=http://localhost:5173         # frontend URL, used in password-reset links

# OpenRouter (Responses API) — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini       # any OpenRouter model id with JSON mode + tool support

# AWS S3 — or MinIO locally (`docker compose up -d`): uncomment S3_ENDPOINT, keep the values below
# S3_ENDPOINT=http://localhost:9000
ACCESSKEY=minioadmin
SECRETKEY=minioadmin
REGION=ap-south-1
BUCKETNAME=apna-ai

# Email (OTP login, password reset, campaign CSVs) — Gmail account + App Password
# https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Or catch all mail locally in Mailpit (http://localhost:8025) — set SMTP_HOST to skip Gmail
# SMTP_HOST=localhost
# SMTP_PORT=1025

# Scraping (needed to build a company knowledge base)
FIRECRAWL_API_KEY=fc-...

# Optional integrations
HUBSPOT_API_ENDPOINT=
HUBPOT_API_KEY=
SPREADSHEET_ID=
DATAINSIGHT_SPREADSHEET_ID=
DEFAULT_COMPANY_ID=
