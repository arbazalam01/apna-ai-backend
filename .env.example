# Copy to .env and fill in: cp .env.example .env
# `npm start` loads .env automatically (node --env-file-if-exists).

PORT=3000
MONGO_DB=mongodb://localhost:27017/apna-ai
SECRET=any-long-random-string            # JWT secret
CLIENT_URL=http://localhost:5173         # frontend URL, used in password-reset links

# OpenAI
OPEN_API_KEY=sk-...
GPT_MODEL=gpt-4-turbo-preview
OPENAI_ASSISTANT_ID=
ASSISTANT_INSTRUCTION=
ASSISTANT_INSTRUCTION_V2=

# AWS S3
ACCESSKEY=
SECRETKEY=
REGION=ap-south-1
BUCKETNAME=

# Email (OTP login, password reset, campaign CSVs) — Gmail account + App Password
# https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Scraping / knowledge base (optional, needed for scraping features)
FIRECRAWL_API_KEY=fc-...
FAST_API=
KNOWLEDGE_BASE_API=

# Optional integrations
HUBSPOT_API_ENDPOINT=
HUBPOT_API_KEY=
SPREADSHEET_ID=
DATAINSIGHT_SPREADSHEET_ID=
DEFAULT_COMPANY_ID=
